<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>summary.movedToTrash</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Flyttet %1$#@items@ (%2$@) fra %3$#@locations@ til papirkurven. Tøm papirkurven for å frigjøre plassen permanent.</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld element</string>
			<key>other</key>
			<string>%lld elementer</string>
		</dict>
		<key>locations</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld plassering</string>
			<key>other</key>
			<string>%lld plasseringer</string>
		</dict>
	</dict>
	<key>summary.deletedPermanently</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Frigjorde %1$@ ved å slette %2$#@items@ permanent fra %3$#@locations@.</string>
		<key>items</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld element</string>
			<key>other</key>
			<string>%lld elementer</string>
		</dict>
		<key>locations</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld plassering</string>
			<key>other</key>
			<string>%lld plasseringer</string>
		</dict>
	</dict>
</dict>
</plist>
