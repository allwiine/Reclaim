{
  "$schema": "../schema/target.schema.json",
  "id": "coursier-cache",
  "category": "jvm",
  "safety": "safe",
  "paths": [
    "~/Library/Caches/Coursier",
    "~/.cache/coursier"
  ],
  "strategy": "removeContents",
  "name": {
    "en": "Coursier cache",
