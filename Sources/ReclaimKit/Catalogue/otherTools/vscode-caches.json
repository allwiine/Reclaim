    "com.microsoft.VSCode"
  ],
  "name": {
    "en": "VS Code caches",
    "nb": "VS Code-cacher"
  },
  "summary": {
    "en": "Extension host, rendering and code caches for Visual Studio Code.",
    "nb": "Extension host-, gjengivelses- og kodecacher for Visual Studio Code."
  }
}
